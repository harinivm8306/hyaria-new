# Copy to backend/.env and edit.

# hybrid     = real sensors from ThingSpeak + simulated pH/EC/light (default)
# simulator  = everything simulated (demo without the prototype)
# thingspeak = real sensors only; actions are logged as advice, nothing is driven
HYARIA_DATA_SOURCE=hybrid

THINGSPEAK_CHANNEL_ID=2899533
THINGSPEAK_READ_KEY=your-read-key
# Which ThingSpeak field holds which sensor. Add "water_level":"field5" (or whichever field
# your prototype uses) once the level sensor publishes.
THINGSPEAK_FIELD_MAP={"humidity":"field1","air_temp":"field2","water_temp":"field3","pump_state":"field4"}
# Water level unit from the prototype: percent, or cm (ultrasonic distance to water surface)
THINGSPEAK_WATER_LEVEL_UNIT=percent
HYARIA_TANK_DEPTH_CM=30

HYARIA_DEVICE_ID=tower-1
HYARIA_CROP=lettuce
HYARIA_PLANTED_DAYS_AGO=12
HYARIA_TANK_CAPACITY_L=40

# Simulator only: 60 = one simulated minute per real second (fast demo)
HYARIA_SIM_SPEED=1
HYARIA_TICK_SECONDS=5

# SQLite by default; for PostgreSQL: postgresql+psycopg://user:pass@host/hyaria
# DATABASE_URL=sqlite:///hyaria.db
